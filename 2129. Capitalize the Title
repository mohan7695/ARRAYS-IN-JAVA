class Solution {
    public String capitalizeTitle(String title) {
        String[] place = title.split(" ");
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < place.length; i++) {
            String word = place[i];

            if (place[i].length() <= 2) {
                sb.append(word.toLowerCase());
            } else {
                char f = Character.toUpperCase(word.charAt(0));

                String r = word.substring(1).toLowerCase();

                sb.append(f).append(r);
            }
            if (i < place.length - 1) {
                sb.append(" ");
            }
        }
        return sb.toString();
    }
}
